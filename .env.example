# Local Ollama runtime
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hoodarunner/hoodaAgents
OLLAMA_TEMPERATURE=0.2
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_TIMEOUT_SECONDS=180

# Agent controls
HOODA_THINK=true
HOODA_MAX_STEPS=8
HOODA_HISTORY_MESSAGES=24
HOODA_MEMORY=on
HOODA_MEMORY_PATH=~/.hoodaagents/memory.db
HOODA_MAX_PROMPT_CHARS=20000
HOODA_MAX_TOOL_OUTPUT_CHARS=12000

# Optional live web search. Offline tools work without this.
TAVILY_API_KEY=
