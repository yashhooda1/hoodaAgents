{
  "name": "hoodaAgents",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "hooda_agents/agent.py",
        "Modelfile"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "python -m pip install -r config/requirements.txt",
  "portsAttributes": {
    "8501": {
      "label": "hoodaAgents Streamlit",
      "onAutoForward": "openPreview"
    },
    "11434": {
      "label": "Ollama API",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [
    8501,
    11434
  ]
}
